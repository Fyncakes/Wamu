# WAMU Backend — PRODUCTION checklist template
# Copy to a secret manager / sealed .env — NEVER commit real values.
# App refuses to start if ENVIRONMENT=production and any guard fails.

APP_NAME=WAMU
ENVIRONMENT=production
DEBUG=false

# openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS_MINIMUM_THIRTY_TWO

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
WS_TICKET_EXPIRE_SECONDS=60

DATABASE_URL=postgresql+asyncpg://wamu:STRONG_PASSWORD@db-host:5432/wamu
REDIS_URL=redis://redis-host:6379/0
CELERY_BROKER_URL=redis://redis-host:6379/1

OTP_MOCK_MODE=false
# OTP_MOCK_CODE unused when mock is off
AFRICASTALKING_USERNAME=REPLACE
AFRICASTALKING_API_KEY=REPLACE
AFRICASTALKING_SENDER_ID=WAMU

S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_PUBLIC_URL=https://cdn.wamu.ug
S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
S3_BUCKET=wamu-media-prod
S3_REGION=af-south-1

CORS_ORIGINS=["https://wamu.ug","https://admin.wamu.ug","https://app.wamu.ug"]

RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_API_PER_MINUTE=120

PAYMENT_MOCK_AUTO_SUCCESS=false
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_STRONG_WEBHOOK_HMAC_SECRET
PLATFORM_FEE_BPS=0
MTN_SUBSCRIPTION_KEY=REPLACE
MTN_API_USER=REPLACE
MTN_API_KEY=REPLACE
MTN_WEBHOOK_SECRET=REPLACE
MTN_BASE_URL=https://proxy.momoapi.mtn.com
MTN_TARGET_ENVIRONMENT=mtnuganda
AIRTEL_CLIENT_ID=REPLACE
AIRTEL_CLIENT_SECRET=REPLACE
AIRTEL_WEBHOOK_SECRET=REPLACE
AIRTEL_BASE_URL=https://openapi.airtel.africa

ADMIN_BOOTSTRAP_PHONE=+2567XXXXXXXX
PUBLIC_MEDIA_BASE=https://cdn.wamu.ug
REALTIME_USE_REDIS=true
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
SENTRY_DSN=
