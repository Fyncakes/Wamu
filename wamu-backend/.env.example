# WAMU Backend — local development template (safe defaults for demos)
# Copy to .env: cp .env.example .env
APP_NAME=WAMU
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-only-change-me-use-32chars-min!!
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
WS_TICKET_EXPIRE_SECONDS=60
DATABASE_URL=postgresql+asyncpg://wamu:wamu@localhost:5432/wamu
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
OTP_EXPIRE_SECONDS=300
OTP_LENGTH=6
OTP_MOCK_MODE=true
OTP_MOCK_CODE=123456
# Africa's Talking — required when OTP_MOCK_MODE=false (never log OTP in API bodies)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=wamuadmin
S3_SECRET_KEY=wamusecret
S3_BUCKET=wamu-media
S3_REGION=us-east-1
# Never use "*" with credentials in staging/production
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8080"]
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_API_PER_MINUTE=120
PAYMENT_MOCK_AUTO_SUCCESS=true
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Platform fee in basis points on merchant payout (250 = 2.5%). 0 = full amount to merchant.
# Fee stays in MoMo float — never a Wamu wallet balance.
PLATFORM_FEE_BPS=0
# MTN MoMo (sandbox) — leave blank for mock theater
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_WEBHOOK_SECRET=
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox
# Airtel Money (UAT)
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_WEBHOOK_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
FCM_SERVER_KEY=
ADMIN_BOOTSTRAP_PHONE=+256700000001
PUBLIC_MEDIA_BASE=http://127.0.0.1:8000
REALTIME_USE_REDIS=true
PRESENCE_TTL_SECONDS=90
# WebRTC ICE — leave TURN blank for STUN-only (LAN / open NAT). For MTN/Airtel CGNAT:
# TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# TURN_USERNAME=wamu
# TURN_CREDENTIAL=wamu-turn-dev
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional crash reporting — leave empty locally
SENTRY_DSN=
