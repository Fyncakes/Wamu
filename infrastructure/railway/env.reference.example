# Paste into Railway → each of wamu-api + wamu-worker (Variables).
# Do NOT commit real values. Generate secrets like infrastructure/.env.staging.example.

ENVIRONMENT=staging
DEBUG=false
SECRET_KEY=CHANGE_ME_staging_secret_key_min_32_chars!!

# Set in Railway after referencing Postgres plugin — use postgresql+asyncpg://…
# DATABASE_URL=postgresql+asyncpg://…
# REDIS_URL=${{Redis.REDIS_URL}}
# CELERY_BROKER_URL=redis://…:6379/1

OTP_MOCK_MODE=true
PAYMENT_MOCK_AUTO_SUCCESS=true
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_staging_webhook_secret
PLATFORM_FEE_BPS=250
PROVIDER_FEE_BPS=150
PAYOUT_AUTO_EXECUTE=false

# After Generate Domain on wamu-api:
PUBLIC_API_BASE=https://YOUR-SERVICE.up.railway.app
PUBLIC_MEDIA_BASE=https://YOUR-SERVICE.up.railway.app

S3_ENABLED=false
REALTIME_USE_REDIS=true
CORS_ORIGINS=["https://YOUR-SERVICE.up.railway.app"]

STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional private coturn. If empty, API uses public OpenRelay TURN so cellular calls work.
# TURN_URLS=turn:YOUR_HOST:3478,turns:YOUR_HOST:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
# TURN_USE_PUBLIC_FALLBACK=true

# Live rails (when mocks off) — MTN first: documentation/MTN_RAILWAY_LAUNCH.md
# MTN_* , FCM_SERVER_KEY , SENTRY_DSN
# Airtel later: documentation/AIRTEL_PORTAL_CHECKLIST.md (fixed egress host)
