# WAMU staging secrets template — copy to .env.staging (do NOT commit real keys)
#   cp infrastructure/.env.staging.example infrastructure/.env.staging
#   # then REPLACE every CHANGE_ME value before inviting beta users
#
# Used by: docker compose -f infrastructure/docker-compose.staging.yml --env-file infrastructure/.env.staging

ENVIRONMENT=staging
DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_staging_secret_key_min_32_chars!!

# Mock-friendly dry-run defaults (no MoMo / Firebase keys required).
# Private-beta gate: set OTP_MOCK_MODE=false + Africa's Talking, and
# PAYMENT_MOCK_AUTO_SUCCESS=false + MTN_* before inviting external testers.
OTP_MOCK_MODE=true
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
PAYMENT_MOCK_AUTO_SUCCESS=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_staging_webhook_secret
PLATFORM_FEE_BPS=0
# Firebase Cloud Messaging server key (Cloud Messaging → Server key)
FCM_SERVER_KEY=

# MTN MoMo sandbox — fill from MoMo Developer portal
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_WEBHOOK_SECRET=
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox

# Airtel Money UAT
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_WEBHOOK_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa

# Include your admin origin and any tunnel hosts used for phone demos
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
REALTIME_USE_REDIS=true
PRESENCE_TTL_SECONDS=90
PUBLIC_MEDIA_BASE=http://localhost:8000
# WebRTC ICE — leave TURN blank for STUN-only. For carrier NAT tests:
#   python -m scripts.print_turn_env   # from wamu-backend — paste output below
#   docker compose -f infrastructure/docker-compose.staging.yml \
#     --env-file infrastructure/.env.staging --profile turn up -d
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_EXTERNAL_IP=
TURN_URLS=
TURN_USERNAME=wamu
TURN_CREDENTIAL=CHANGE_ME_staging_turn_credential
SENTRY_DSN=
