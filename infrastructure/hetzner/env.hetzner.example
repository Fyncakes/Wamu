# Copy to infrastructure/hetzner/.env.hetzner (gitignored) and fill secrets.
ENVIRONMENT=staging
DEBUG=false
SECRET_KEY=CHANGE_ME
OTP_MOCK_MODE=true
PAYMENT_MOCK_AUTO_SUCCESS=true
PAYMENT_WEBHOOK_SECRET=CHANGE_ME
PLATFORM_FEE_BPS=250
PROVIDER_FEE_BPS=150
PAYOUT_AUTO_EXECUTE=false
SUSPENSE_ALERT_THRESHOLD_MINOR=100000
PUBLIC_API_BASE=https://REPLACE_WITH_PUBLIC_HTTPS
CORS_ORIGINS=["https://wamu.ug","https://admin.wamu.ug","*"]
REALTIME_USE_REDIS=true
PRESENCE_TTL_SECONDS=90
PUBLIC_MEDIA_BASE=https://REPLACE_WITH_PUBLIC_HTTPS
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
POSTGRES_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=wamuadmin
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=wamu-media
