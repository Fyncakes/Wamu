# Copy to infrastructure/gcp/.env.gcp and fill before setup/deploy.
# NEVER commit .env.gcp

# --- GCP project ---
GCP_PROJECT_ID=wamu-prod
GCP_REGION=europe-west1
# Optional: override Artifact Registry repo name
# AR_REPO=wamu

# --- Cloud SQL ---
SQL_INSTANCE=wamu-pg
SQL_TIER=db-f1-micro
SQL_DB=wamu
SQL_USER=wamu
# openssl rand -base64 24
SQL_PASSWORD=REPLACE_STRONG_PASSWORD

# --- Redis ---
# memorystore = VPC connector + Memorystore (recommended)
# external   = set REDIS_URL / CELERY_BROKER_URL to Upstash or similar (faster first deploy)
REDIS_MODE=memorystore
MEMORYSTORE_NAME=wamu-redis
MEMORYSTORE_SIZE_GB=1
VPC_CONNECTOR=wamu-vpc-connector

# If REDIS_MODE=external:
# REDIS_URL=rediss://default:TOKEN@HOST:6379/0
# CELERY_BROKER_URL=rediss://default:TOKEN@HOST:6379/1

# --- GCS media (S3-compatible HMAC) ---
GCS_BUCKET=wamu-media-prod
# Create HMAC keys in GCS settings; map to S3_* on the Cloud Run service

# --- Cloud Run ---
CLOUD_RUN_API=wamu-api
CLOUD_RUN_WORKER=wamu-worker
CLOUD_RUN_BEAT=wamu-beat
# staging | production  (production enforces fail-closed guards)
WAMU_ENVIRONMENT=staging
# After first deploy, set to the Cloud Run URL or custom domain
PUBLIC_API_BASE=https://REPLACE.run.app
PUBLIC_MEDIA_BASE=https://storage.googleapis.com/wamu-media-prod

# --- App secrets (also stored in Secret Manager by setup.sh) ---
SECRET_KEY=REPLACE_openssl_rand_hex_32
PAYMENT_WEBHOOK_SECRET=REPLACE_openssl_rand_hex_24
ADMIN_BOOTSTRAP_PHONE=+256700000001
CORS_ORIGINS=["https://wamu.ug","https://admin.wamu.ug"]

# MoMo — keep mock on for first GCP smoke; flip off when sandbox keys are live
OTP_MOCK_MODE=true
PAYMENT_MOCK_AUTO_SUCCESS=true
PAYOUT_AUTO_EXECUTE=true
